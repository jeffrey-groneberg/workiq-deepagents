# Azure model deployment used by Deep Agents.
WORKIQ_AGENT_MODEL=gpt-5.6-sol
WORKIQ_AGENT_MODEL_BASE_URL=https://YOUR-RESOURCE-NAME.services.ai.azure.com/openai/v1/
WORKIQ_AGENT_MODEL_TOKEN_SCOPE=https://ai.azure.com/.default
WORKIQ_AGENT_MODEL_TENANT_ID=00000000-0000-0000-0000-000000000000

# GPT-5.6 SOL Global Standard retail rates in USD per million tokens.
WORKIQ_AGENT_PRICING_INPUT_PER_MILLION_USD=5.00
WORKIQ_AGENT_PRICING_CACHED_INPUT_PER_MILLION_USD=0.50
WORKIQ_AGENT_PRICING_OUTPUT_PER_MILLION_USD=30.00

# Optional Microsoft Entra tenant ID. WorkIQ defaults to "common" when omitted.
# WORKIQ_AGENT_TENANT_ID=00000000-0000-0000-0000-000000000000
